DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bunakar
JWT_SECRET=change-me-in-production
PORT=3000
NODE_ENV=development
# Comma-separated origins allowed to call the API. Leave unset in local dev to allow any.
# Required in production (the server refuses to start without it).
# CORS_ORIGIN=http://localhost:5173
# The schema comes from migrations, run on boot (npm run migration:run does the same by hand).
